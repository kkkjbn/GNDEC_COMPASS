{
  "name": "gndec-compass",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "GNDEC Compass 2.0 — one calm place for timetables, people, rooms, routes, syllabus, papers and notices.",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "data:fast": "node scripts/build-data.mjs --skip-pdf",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-data.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pdfjs-dist": "^4.10.38",
    "wrangler": "^4.40.0"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
